# Copy this file to .env and fill in your real values. Never commit .env.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional: Portfolio Architecture tiers -- separate paper sub-accounts shown
# read-only on the dashboard (no automated trading against these). If unset,
# those tiers just show as "not connected". The Conservative tier reuses the
# primary ALPACA_API_KEY/SECRET_KEY above.
ALPACA_GROWTH_API_KEY=
ALPACA_GROWTH_SECRET_KEY=
ALPACA_AGGRESSIVE_API_KEY=
ALPACA_AGGRESSIVE_SECRET_KEY=

# Paper endpoint by default. Do not change unless you intend to trade live.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Must be set to exactly "yes" to allow orders to be sent to a non-paper
# (live) base URL. This is an intentional speed bump, not a real safeguard.
CONFIRM_LIVE_TRADING=no

# Credentials for the web dashboard (HTTP Basic Auth). Required to run web/app.py.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
